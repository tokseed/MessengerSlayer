<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Messenger.Client.ViewModels" xmlns:ui="using:Messenger.Client.UIModels" x:Class="Messenger.Client.Views.ChatsView" x:DataType="vm:ChatsViewModel">
  <Grid ColumnDefinitions="316,*" Background="{DynamicResource Brush.App}" Classes="fade-in">
    <Border Grid.Column="0" Background="{DynamicResource Brush.Sidebar}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,Auto,*,Auto">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="18,18,14,14">
          <TextBlock VerticalAlignment="Center" FontSize="20" FontWeight="SemiBold" Text="Messenger"/>
          <Button Grid.Column="1" Classes="icon-button" ToolTip.Tip="Новый чат" Command="{Binding CreateChatCommand}"><Path Width="16" Height="16" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" StrokeLineCap="Round" Data="{StaticResource Icon.Plus}"/></Button>
        </Grid>
        <Grid Grid.Row="1" Margin="14,0,14,10"><TextBox Classes="search-field" PlaceholderText="Поиск" Text="{Binding SearchText}"/><Path Width="15" Height="15" Margin="13,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" Stroke="{DynamicResource Brush.TextMuted}" StrokeThickness="1.6" StrokeLineCap="Round" Data="{StaticResource Icon.Search}"/></Grid>
        <Grid Grid.Row="2">
          <ListBox Margin="8,0,8,10" Classes="chat-list" ItemsSource="{Binding Chats}" SelectedItem="{Binding SelectedChat}" IsVisible="{Binding HasChats}">
            <ListBox.ItemTemplate><DataTemplate x:DataType="ui:ChatListItem"><Grid ColumnDefinitions="48,*,Auto" Margin="9,8">
              <Grid Width="40" Height="40"><Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="20"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Text="{Binding Initials}"/></Border><Ellipse Width="9" Height="9" HorizontalAlignment="Right" VerticalAlignment="Bottom" Fill="{DynamicResource Brush.Online}" Stroke="{DynamicResource Brush.Sidebar}" StrokeThickness="2" IsVisible="{Binding IsOnline}"/></Grid>
              <StackPanel Grid.Column="1" Margin="10,1,8,0"><TextBlock FontSize="13" FontWeight="SemiBold" Text="{Binding Title}"/><TextBlock Margin="0,5,0,0" MaxWidth="180" FontSize="11.5" Foreground="{DynamicResource Brush.TextSecondary}" TextTrimming="CharacterEllipsis" Text="{Binding LastMessage}"/></StackPanel>
              <StackPanel Grid.Column="2" HorizontalAlignment="Right"><TextBlock FontSize="10" Foreground="{DynamicResource Brush.TextMuted}" Text="{Binding TimeText}"/><Border Margin="0,7,0,0" MinWidth="19" Height="19" Padding="5,0" Background="{DynamicResource Brush.Accent}" CornerRadius="10" IsVisible="{Binding HasUnreadMessages}"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="9.5" FontWeight="SemiBold" Foreground="White" Text="{Binding UnreadCount}"/></Border></StackPanel>
            </Grid></DataTemplate></ListBox.ItemTemplate>
          </ListBox>
          <StackPanel Margin="30" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Classes="soft-enter" IsVisible="{Binding IsChatListEmpty}"><Path Width="28" Height="28" Stretch="Uniform" Fill="{DynamicResource Brush.TextMuted}" Data="{StaticResource Icon.Brand}"/><TextBlock HorizontalAlignment="Center" FontSize="13" Foreground="{DynamicResource Brush.TextSecondary}" Text="Чатов пока нет"/><Button Classes="text-button" Content="Создать первый чат" Command="{Binding CreateChatCommand}"/></StackPanel>
        </Grid>
        <Border Grid.Row="3" Margin="10,6,10,10" Padding="8" Background="Transparent" CornerRadius="11"><Grid ColumnDefinitions="40,*,Auto"><Border Width="34" Height="34" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="17"><Path Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform" Stroke="{DynamicResource Brush.TextSecondary}" StrokeThickness="1.45" StrokeLineCap="Round" Data="{StaticResource Icon.User}"/></Border><TextBlock Grid.Column="1" Margin="9,0,8,0" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Text="{Binding Username}"/><Button Grid.Column="2" Classes="icon-button" ToolTip.Tip="Настройки" Command="{Binding OpenSettingsCommand}"><Path Width="16" Height="16" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.45" StrokeLineCap="Round" Data="{StaticResource Icon.Settings}"/></Button></Grid></Border>
      </Grid>
    </Border>
    <Grid Grid.Column="1">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="13" Classes="soft-enter" IsVisible="{Binding HasNoSelectedChat}"><Border Width="56" Height="56" Background="{DynamicResource Brush.Panel}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="28"><Path Width="25" Height="25" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform" Fill="{DynamicResource Brush.TextSecondary}" Data="{StaticResource Icon.Brand}"/></Border><TextBlock HorizontalAlignment="Center" FontSize="15" FontWeight="SemiBold" Text="Выберите чат"/><TextBlock MaxWidth="250" HorizontalAlignment="Center" TextAlignment="Center" FontSize="12" LineHeight="18" Foreground="{DynamicResource Brush.TextMuted}" TextWrapping="Wrap" Text="Откройте существующий разговор или создайте новый."/></StackPanel>
      <Grid RowDefinitions="68,*,Auto" IsVisible="{Binding HasSelectedChat}">
        <Border Grid.Row="0" Background="{DynamicResource Brush.App}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1"><Grid ColumnDefinitions="*,Auto" Margin="22,0,16,0"><StackPanel VerticalAlignment="Center"><TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding SelectedChat.Title}"/><TextBlock Margin="0,4,0,0" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" Text="Разговор"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center"><Button Classes="icon-button" ToolTip.Tip="Поиск в чате"><Path Width="16" Height="16" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" StrokeLineCap="Round" Data="{StaticResource Icon.Search}"/></Button><Button Classes="icon-button" ToolTip.Tip="Ещё"><Path Width="16" Height="16" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="{StaticResource Icon.More}"/></Button></StackPanel></Grid></Border>
        <ScrollViewer Grid.Row="1" Padding="28,22"><ItemsControl ItemsSource="{Binding Messages}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="ui:MessageItem"><Grid Margin="0,3" Classes="fade-in"><Border Classes="message-bubble" Classes.own="{Binding IsOwn}"><StackPanel><TextBlock FontSize="13.5" LineHeight="19" TextWrapping="Wrap" Text="{Binding Text}"/><StackPanel Margin="0,5,0,0" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="5"><TextBlock FontSize="9.5" Foreground="{DynamicResource Brush.TextMuted}" Text="{Binding TimeText}"/><TextBlock FontSize="9.5" Foreground="{DynamicResource Brush.Accent}" Text="{Binding StatusText}"/></StackPanel></StackPanel></Border></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
        <Grid Grid.Row="2" Margin="20,8,20,18"><Border Padding="7" Background="{DynamicResource Brush.Panel}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="15"><Grid ColumnDefinitions="Auto,*,Auto"><Button Grid.Column="0" Classes="icon-button" ToolTip.Tip="Прикрепить" IsEnabled="False"><Path Width="17" Height="17" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.55" StrokeLineCap="Round" StrokeJoin="Round" Data="{StaticResource Icon.Attach}"/></Button><TextBox Grid.Column="1" Margin="4,0,8,0" Classes="composer-field" PlaceholderText="Сообщение" Text="{Binding MessageText}"/><Button Grid.Column="2" Classes="send-button" ToolTip.Tip="Отправить" Command="{Binding SendMessageCommand}"><Path Width="17" Height="17" Stretch="Uniform" Fill="White" Data="{StaticResource Icon.Send}"/></Button></Grid></Border></Grid>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
