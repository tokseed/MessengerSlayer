<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Messenger.Client.ViewModels" x:Class="Messenger.Client.Views.SettingsView" x:DataType="vm:SettingsViewModel">
  <Grid Background="{DynamicResource Brush.App}">
    <Grid Width="620" Margin="32" HorizontalAlignment="Center">
      <StackPanel Classes="soft-enter">
        <StackPanel Orientation="Horizontal" Spacing="12"><Button Classes="icon-button" ToolTip.Tip="Назад" Command="{Binding BackCommand}"><Path Width="15" Height="15" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" StrokeLineCap="Round" StrokeJoin="Round" Data="{StaticResource Icon.Back}"/></Button><TextBlock VerticalAlignment="Center" FontSize="23" FontWeight="SemiBold" Text="Настройки"/></StackPanel>
        <Border Margin="0,26,0,0" Classes="section-card"><Grid ColumnDefinitions="44,*"><Border Width="38" Height="38" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="19"><Path Width="17" Height="17" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform" Stroke="{DynamicResource Brush.TextSecondary}" StrokeThickness="1.45" StrokeLineCap="Round" Data="{StaticResource Icon.User}"/></Border><StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"><TextBlock FontSize="13" FontWeight="SemiBold" Text="{Binding Username}"/><TextBlock Margin="0,3,0,0" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" Text="Учётная запись"/></StackPanel></Grid></Border>
        <Border Margin="0,14,0,0" Classes="section-card"><StackPanel Spacing="18"><Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock FontSize="13" FontWeight="SemiBold" Text="Уведомления"/><TextBlock Margin="0,4,0,0" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" Text="Показывать уведомления о новых сообщениях"/></StackPanel><ToggleSwitch Grid.Column="1" IsChecked="{Binding NotificationsEnabled}"/></Grid><Border Height="1" Background="{DynamicResource Brush.Border}"/><Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock FontSize="13" FontWeight="SemiBold" Text="Запуск вместе с системой"/><TextBlock Margin="0,4,0,0" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" Text="Открывать Messenger после входа в систему"/></StackPanel><ToggleSwitch Grid.Column="1" IsChecked="{Binding LaunchOnStartup}"/></Grid></StackPanel></Border>
        <Button Margin="0,20,0,0" HorizontalAlignment="Left" Classes="danger-button" Content="Выйти из аккаунта" Command="{Binding LogoutCommand}"/>
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
