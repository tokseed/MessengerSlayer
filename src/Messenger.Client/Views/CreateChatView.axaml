<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Messenger.Client.ViewModels" xmlns:ui="using:Messenger.Client.UIModels" x:Class="Messenger.Client.Views.CreateChatView" x:DataType="vm:CreateChatViewModel">
  <Grid Background="{DynamicResource Brush.App}">
    <Grid Width="620" Margin="32" HorizontalAlignment="Center">
      <StackPanel Classes="soft-enter">
        <StackPanel Orientation="Horizontal" Spacing="12"><Button Classes="icon-button" ToolTip.Tip="Назад" Command="{Binding BackCommand}"><Path Width="15" Height="15" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" StrokeLineCap="Round" StrokeJoin="Round" Data="{StaticResource Icon.Back}"/></Button><StackPanel VerticalAlignment="Center"><TextBlock FontSize="23" FontWeight="SemiBold" Text="Новый чат"/><TextBlock Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource Brush.TextMuted}" Text="Добавьте участников и при необходимости задайте название"/></StackPanel></StackPanel>
        <Border Margin="0,26,0,0" Classes="section-card"><StackPanel><TextBlock FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}" Text="Название"/><TextBox Margin="0,8,0,0" Classes="field" PlaceholderText="Необязательно" Text="{Binding ChatTitle}"/><TextBlock Margin="0,20,0,0" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}" Text="Участник"/><Grid Margin="0,8,0,0" ColumnDefinitions="*,Auto"><TextBox Grid.Column="0" Classes="field" PlaceholderText="Имя пользователя" Text="{Binding MemberUsername}"/><Button Grid.Column="1" Margin="8,0,0,0" Width="44" Classes="primary" ToolTip.Tip="Добавить" Command="{Binding AddMemberCommand}"><Path Width="15" Height="15" Stretch="Uniform" Stroke="White" StrokeThickness="1.7" StrokeLineCap="Round" Data="{StaticResource Icon.Plus}"/></Button></Grid></StackPanel></Border>
        <Border Margin="0,14,0,0" MinHeight="170" Classes="section-card"><Grid><ListBox ItemsSource="{Binding Members}" SelectedItem="{Binding SelectedMember}" Background="Transparent" BorderThickness="0" IsVisible="{Binding HasMembers}"><ListBox.ItemTemplate><DataTemplate x:DataType="ui:CreateChatMemberItem"><Grid ColumnDefinitions="38,*" Margin="4,6"><Border Width="32" Height="32" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="16"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Text="{Binding Initials}"/></Border><TextBlock Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center" FontSize="13" Text="{Binding Username}"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" IsVisible="{Binding IsMemberListEmpty}"><Path Width="22" Height="22" Stretch="Uniform" Stroke="{DynamicResource Brush.TextMuted}" StrokeThickness="1.4" StrokeLineCap="Round" Data="{StaticResource Icon.User}"/><TextBlock FontSize="12" Foreground="{DynamicResource Brush.TextMuted}" Text="Участники не добавлены"/></StackPanel></Grid></Border>
        <Grid Margin="0,14,0,0" ColumnDefinitions="*,Auto,Auto"><TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource Brush.Danger}" Text="{Binding StatusText}"/><Button Grid.Column="1" Margin="8,0,0,0" Classes="text-button" Content="Убрать выбранного" Command="{Binding RemoveSelectedMemberCommand}"/><Button Grid.Column="2" Margin="8,0,0,0" MinWidth="128" Classes="primary" Content="Создать" Command="{Binding CreateChatCommand}"/></Grid>
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
