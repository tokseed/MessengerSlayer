<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style Selector="Window"><Setter Property="Background" Value="{DynamicResource Brush.App}"/><Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/><Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, Arial"/></Style>
    <Style Selector="TextBox.field"><Setter Property="MinHeight" Value="44"/><Setter Property="Padding" Value="13,10"/><Setter Property="Background" Value="{DynamicResource Brush.Surface}"/><Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/><Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="10"/><Setter Property="FontSize" Value="14"/><Setter Property="CaretBrush" Value="{DynamicResource Brush.TextPrimary}"/><Setter Property="Transitions"><Transitions><BrushTransition Property="Background" Duration="0:0:0.10"/><BrushTransition Property="BorderBrush" Duration="0:0:0.10"/></Transitions></Setter></Style>
    <Style Selector="TextBox.search-field"><Setter Property="MinHeight" Value="40"/><Setter Property="Padding" Value="38,8,12,8"/><Setter Property="Background" Value="{DynamicResource Brush.Surface}"/><Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/><Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="10"/><Setter Property="FontSize" Value="13"/></Style>
    <Style Selector="TextBox.composer-field"><Setter Property="MinHeight" Value="42"/><Setter Property="Padding" Value="8,8"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="14"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style Selector="Button.primary"><Setter Property="MinHeight" Value="44"/><Setter Property="Padding" Value="18,10"/><Setter Property="Background" Value="{DynamicResource Brush.Accent}"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="CornerRadius" Value="10"/><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="RenderTransformOrigin" Value="50%,50%"/><Setter Property="RenderTransform" Value="scale(1)"/><Setter Property="Transitions"><Transitions><BrushTransition Property="Background" Duration="0:0:0.10"/><DoubleTransition Property="Opacity" Duration="0:0:0.10"/><TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.10"/></Transitions></Setter></Style>
    <Style Selector="Button.primary:pointerover"><Setter Property="Background" Value="{DynamicResource Brush.AccentHover}"/><Setter Property="RenderTransform" Value="scale(1.012)"/></Style>
    <Style Selector="Button.primary:pressed"><Setter Property="Background" Value="{DynamicResource Brush.AccentPressed}"/><Setter Property="RenderTransform" Value="scale(0.985)"/></Style>
    <Style Selector="Button.primary:disabled"><Setter Property="Opacity" Value="0.45"/></Style>
    <Style Selector="Button.text-button"><Setter Property="Padding" Value="7,4"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="CornerRadius" Value="7"/><Setter Property="FontSize" Value="12"/><Setter Property="Transitions"><Transitions><BrushTransition Property="Foreground" Duration="0:0:0.10"/><BrushTransition Property="Background" Duration="0:0:0.10"/></Transitions></Setter></Style>
    <Style Selector="Button.text-button:pointerover"><Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/><Setter Property="Background" Value="{DynamicResource Brush.SurfaceHover}"/></Style>
    <Style Selector="Button.icon-button"><Setter Property="Width" Value="36"/><Setter Property="Height" Value="36"/><Setter Property="Padding" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="CornerRadius" Value="9"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="RenderTransformOrigin" Value="50%,50%"/><Setter Property="RenderTransform" Value="scale(1)"/><Setter Property="Transitions"><Transitions><BrushTransition Property="Background" Duration="0:0:0.09"/><BrushTransition Property="Foreground" Duration="0:0:0.09"/><TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.09"/></Transitions></Setter></Style>
    <Style Selector="Button.icon-button:pointerover"><Setter Property="Background" Value="{DynamicResource Brush.SurfaceHover}"/><Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/><Setter Property="RenderTransform" Value="scale(1.035)"/></Style>
    <Style Selector="Button.icon-button:pressed"><Setter Property="RenderTransform" Value="scale(0.94)"/></Style>
    <Style Selector="Button.send-button"><Setter Property="Width" Value="40"/><Setter Property="Height" Value="40"/><Setter Property="Padding" Value="0"/><Setter Property="Background" Value="{DynamicResource Brush.Accent}"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="CornerRadius" Value="20"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="RenderTransformOrigin" Value="50%,50%"/><Setter Property="RenderTransform" Value="scale(1)"/><Setter Property="Transitions"><Transitions><BrushTransition Property="Background" Duration="0:0:0.09"/><TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.09"/></Transitions></Setter></Style>
    <Style Selector="Button.send-button:pointerover"><Setter Property="Background" Value="{DynamicResource Brush.AccentHover}"/><Setter Property="RenderTransform" Value="scale(1.045)"/></Style>
    <Style Selector="Button.send-button:pressed"><Setter Property="RenderTransform" Value="scale(0.93)"/></Style>
    <Style Selector="Button.send-button:disabled"><Setter Property="Opacity" Value="0.4"/></Style>
    <Style Selector="Button.danger-button"><Setter Property="MinHeight" Value="42"/><Setter Property="Padding" Value="16,9"/><Setter Property="Background" Value="{DynamicResource Brush.DangerSoft}"/><Setter Property="Foreground" Value="{DynamicResource Brush.Danger}"/><Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="10"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style Selector="ListBox.chat-list"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style>
    <Style Selector="ListBox.chat-list > ListBoxItem"><Setter Property="Margin" Value="0,1"/><Setter Property="Padding" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="CornerRadius" Value="11"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Transitions"><Transitions><BrushTransition Property="Background" Duration="0:0:0.10"/></Transitions></Setter></Style>
    <Style Selector="ListBox.chat-list > ListBoxItem:pointerover"><Setter Property="Background" Value="{DynamicResource Brush.SurfaceHover}"/></Style>
    <Style Selector="ListBox.chat-list > ListBoxItem:selected"><Setter Property="Background" Value="{DynamicResource Brush.SurfaceSelected}"/></Style>
    <Style Selector="Border.message-bubble"><Setter Property="MaxWidth" Value="560"/><Setter Property="Padding" Value="13,9"/><Setter Property="HorizontalAlignment" Value="Left"/><Setter Property="Background" Value="{DynamicResource Brush.IncomingBubble}"/><Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12,12,12,4"/></Style>
    <Style Selector="Border.message-bubble.own"><Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="Background" Value="{DynamicResource Brush.OutgoingBubble}"/><Setter Property="BorderBrush" Value="{DynamicResource Brush.OutgoingBubble}"/><Setter Property="CornerRadius" Value="12,12,4,12"/></Style>
    <Style Selector="Border.section-card"><Setter Property="Background" Value="{DynamicResource Brush.Panel}"/><Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="14"/><Setter Property="Padding" Value="18"/></Style>
</Styles>
