<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <Color x:Key="Color.App">#0F1012</Color><Color x:Key="Color.Sidebar">#141518</Color><Color x:Key="Color.Panel">#17191D</Color><Color x:Key="Color.Surface">#1B1D22</Color><Color x:Key="Color.SurfaceHover">#202329</Color><Color x:Key="Color.SurfaceSelected">#24272E</Color><Color x:Key="Color.Border">#292C32</Color><Color x:Key="Color.BorderStrong">#353941</Color>
    <Color x:Key="Color.TextPrimary">#F4F5F7</Color><Color x:Key="Color.TextSecondary">#A2A6AE</Color><Color x:Key="Color.TextMuted">#70757F</Color>
    <Color x:Key="Color.Accent">#7B78FF</Color><Color x:Key="Color.AccentHover">#8A87FF</Color><Color x:Key="Color.AccentPressed">#6C69EA</Color><Color x:Key="Color.AccentSoft">#282747</Color>
    <Color x:Key="Color.Online">#54C58A</Color><Color x:Key="Color.Danger">#E07073</Color><Color x:Key="Color.DangerSoft">#321E21</Color><Color x:Key="Color.CloseHover">#C83B42</Color>
    <Color x:Key="Color.IncomingBubble">#1B1D22</Color><Color x:Key="Color.OutgoingBubble">#2A2945</Color>
    <SolidColorBrush x:Key="Brush.App" Color="{StaticResource Color.App}"/><SolidColorBrush x:Key="Brush.Sidebar" Color="{StaticResource Color.Sidebar}"/><SolidColorBrush x:Key="Brush.Panel" Color="{StaticResource Color.Panel}"/><SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}"/><SolidColorBrush x:Key="Brush.SurfaceHover" Color="{StaticResource Color.SurfaceHover}"/><SolidColorBrush x:Key="Brush.SurfaceSelected" Color="{StaticResource Color.SurfaceSelected}"/><SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}"/><SolidColorBrush x:Key="Brush.BorderStrong" Color="{StaticResource Color.BorderStrong}"/>
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="{StaticResource Color.TextPrimary}"/><SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}"/><SolidColorBrush x:Key="Brush.TextMuted" Color="{StaticResource Color.TextMuted}"/>
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}"/><SolidColorBrush x:Key="Brush.AccentHover" Color="{StaticResource Color.AccentHover}"/><SolidColorBrush x:Key="Brush.AccentPressed" Color="{StaticResource Color.AccentPressed}"/><SolidColorBrush x:Key="Brush.AccentSoft" Color="{StaticResource Color.AccentSoft}"/><SolidColorBrush x:Key="Brush.Online" Color="{StaticResource Color.Online}"/><SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}"/><SolidColorBrush x:Key="Brush.DangerSoft" Color="{StaticResource Color.DangerSoft}"/><SolidColorBrush x:Key="Brush.CloseHover" Color="{StaticResource Color.CloseHover}"/><SolidColorBrush x:Key="Brush.IncomingBubble" Color="{StaticResource Color.IncomingBubble}"/><SolidColorBrush x:Key="Brush.OutgoingBubble" Color="{StaticResource Color.OutgoingBubble}"/>
  </Styles.Resources>
</Styles>
